# Copy to `.env` and fill in. In production, set these as real environment vars.

# SQLite database file (relative to the project root).
DATABASE_URL=data/openguessr.db

# Better Auth — generate a long random string, e.g. `openssl rand -hex 32`.
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Seeded on first startup if no admin exists yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
